  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "The quiet tooltip button; most actions.",
      "html": "<button class=\"ds-btn\">Open folder</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 15px;border-radius:5px;border:1px solid #30343f;background:#1a1d26;color:#f1ede3;font:550 14px var(--f-ui,'Geist',sans-serif);cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.06);transition:background-color .15s cubic-bezier(.16,1,.3,1),border-color .15s cubic-bezier(.16,1,.3,1),transform .1s}.ds-btn:hover{background:#222632;border-color:#9c7d36}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid #ffd877;outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
