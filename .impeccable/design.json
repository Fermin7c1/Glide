    {
      "name": "Switch",
      "kind": "input",
      "refersTo": "switch",
      "description": "A toggle whose state is knob position and fill, with a text state.",
      "html": "<label class=\"ds-sw\"><input type=\"checkbox\" checked><span class=\"tr\"></span><span>On</span></label>",
      "css": ".ds-sw{display:inline-flex;align-items:center;gap:10px;cursor:pointer;color:#bab5a8;font:400 13px var(--f-ui,'Geist',sans-serif)}.ds-sw input{position:absolute;opacity:0;width:1px;height:1px}.ds-sw .tr{position:relative;width:40px;height:22px;border-radius:11px;background:#07080b;border:1px solid #30343f;box-shadow:inset 0 1px 2px rgba(0,0,0,.6);transition:background-color .18s}.ds-sw .tr::after{content:'';position:absolute;top:3px;left:3px;width:14px;height:14px;border-radius:50%;background:#8b867b;transition:transform .2s cubic-bezier(.16,1,.3,1)}.ds-sw input:checked+.tr{background:#f2c24f;border-color:#6b5220}.ds-sw input:checked+.tr::after{transform:translateX(18px);background:#1d1504}.ds-sw input:focus-visible+.tr{outline:2px solid #ffd877;outline-offset:2px}"
    },
    {
      "name": "Rail",
      "kind": "nav",
      "refersTo": "rail-item-active",
      "description": "The shell's icon rail; the active item in gold on gold wash.",
      "html": "<nav class=\"ds-rail\"><button class=\"ds-rail-i on\"><svg viewBox=\"0 0 24 24\" width=\"21\" height=\"21\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M3 11l9-7 9 7M5 9.5V20h14V9.5\"/></svg>Coach</button><button class=\"ds-rail-i\"><svg viewBox=\"0 0 24 24\" width=\"21\" height=\"21\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3\"/></svg>Settings</button></nav>",
      "css": ".ds-rail{width:84px;display:flex;flex-direction:column;gap:2px;padding:16px 8px;background:#07080b;border-right:1px solid #22252e}.ds-rail-i{display:flex;flex-direction:column;align-items:center;gap:5px;padding:10px 2px 9px;border:0;border-radius:7px;background:transparent;color:#8b867b;font:500 12px var(--f-ui,'Geist',sans-serif);cursor:pointer;transition:background-color .15s,color .15s}.ds-rail-i:hover{color:#f1ede3;background:#13151c}.ds-rail-i.on{color:#f2c24f;background:rgba(242,194,79,.1)}.ds-rail-i:focus-visible{outline:2px solid #ffd877;outline-offset:2px}"
    },
    {
      "name": "Book Tabs",
