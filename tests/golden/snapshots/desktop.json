         "5m",
         "5 minutes"
        ],
        [
         "1h",
         "1 hour"
        ]
       ],
       "restart": true,
       "type": "select"
      },
      {
       "def": true,
       "help": "Callouts and spoken questions then share one cached prefix.",
       "key": "companion.llm.callout_tools",
       "label": "Send tool definitions with callouts",
       "restart": true,
       "type": "bool"
      }
