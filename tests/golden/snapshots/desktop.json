 "schema": [
  {
   "groups": [
    {
     "fields": [
      {
       "def": true,
       "key": "app:autoStartEngine",
       "label": "Start the coach when the app opens",
       "type": "bool"
      },
      {
       "def": true,
       "help": "Glide checks GitHub for a newer version every 30 minutes and tells you when there is one. Download it from the footer; nothing installs until you click Restart to update. Your data and settings are kept.",
       "key": "app:autoUpdate",
       "label": "Check for updates",
       "type": "bool"
      },
      {
       "def": false,
       "help": "Off: closing the window quits Glide, the coach included. On: the window only hides, and the overlay, voice and push-to-talk keep working; quit from the tray icon.",
       "key": "app:closeToTray",
       "label": "Keep Glide running in the tray when the window is closed",
       "type": "bool"
      }
     ],
     "title": "App"
    },
    {
     "fields": [
      {
       "def": false,
       "help": "A simulated Skyborne Alliance warrior levels through your RestedXP guides. No game needed. Nothing is saved.",
       "key": "app:engineArgs.sim",
       "label": "Simulation mode",
       "restart": true,
       "type": "bool"
      },
      {
       "def": true,
       "help": "Hold the push-to-talk key (Voice settings) to ask the coach out loud.",
       "invert": true,
       "key": "app:engineArgs.noPtt",
       "label": "Push-to-talk",
       "restart": true,
       "type": "bool"
      },
      {
       "def": true,
       "help": "Copies them into data\\archive whenever they change, because the beta client doesn't read them back. Your recordings depend on it.",
       "invert": true,
       "key": "app:engineArgs.noArchive",
       "label": "Archive SavedVariables and the quest cache",
       "restart": true,
       "type": "bool"
      },
      {
       "def": true,
       "help": "Merges new recordings and RestedXP updates while you play, then switches over without a restart.",
       "invert": true,
       "key": "app:engineArgs.noKb",
       "label": "Rebuild the knowledge base in the background",
       "restart": true,
       "type": "bool"
      }
     ],
     "title": "Coach process"
    },
    {
     "special": "walk-map",
     "title": "Walking map"
    },
    {
     "special": "data-home",
     "title": "Data"
    }
   ],
   "id": "general",
   "title": "General"
  },
  {
   "groups": [
    {
     "intro": "Keys are encrypted with your Windows account and passed to the coach when it starts. They are never written to config.json. Changes apply on the next coach restart.",
     "special": "keys",
     "title": "API keys"
    },
    {
     "intro": "Every model your keys and endpoints can use, cheapest first within each provider, with what it would cost an hour at your usage. A change applies to the next call.",
     "special": "model-picker",
     "title": "Choose models"
    },
    {
     "fields": [
      {
       "def": "claude-haiku-4-5-20251001",
       "help": "Live callouts, spoken questions and quest briefings.",
       "key": "companion.llm.fast_model",
       "label": "Fast model",
       "type": "text",
       "wide": true
      },
      {
       "def": "claude-sonnet-5-5",
       "help": "Typed questions and pace reviews.",
       "key": "companion.llm.deep_model",
       "label": "Deep model",
       "type": "text",
       "wide": true
      },
      {
       "def": "fast",
       "key": "companion.llm.voice_question_model",
       "label": "Spoken questions use",
       "options": [
        [
         "fast",
         "the fast model"
        ],
        [
         "deep",
         "the deep model"
        ]
       ],
       "restart": true,
       "type": "select"
      },
      {
       "def": true,
       "help": "Off: only simple rule-based callouts, with no API calls.",
       "key": "companion.llm.enabled",
       "label": "AI coach on",
       "restart": true,
       "type": "bool"
      }
     ],
     "intro": "Or type an id: claude-… (Anthropic), gemini:<id> (Gemini API), vendor/model (OpenRouter), ep:<endpoint>:<model> (custom endpoint).",
     "title": "Model ids"
    },
    {
     "intro": "Any OpenAI-compatible server: a local Ollama (http://127.0.0.1:11434/v1) or LM Studio (http://127.0.0.1:1234/v1), OpenAI, Groq, Mistral, DeepSeek, Together… Their models join the list above as ep:<id>:<model>.",
     "special": "endpoints",
     "title": "Custom endpoints"
    },
    {
     "fields": [
      {
       "def": 25,
       "key": "companion.llm.timeout",
       "label": "Request timeout (s)",
       "max": 120,
       "min": 5,
       "restart": true,
       "type": "number"
      },
      {
       "def": 1,
       "key": "companion.llm.busy_retry_s",
       "label": "Retry a busy model after (s)",
