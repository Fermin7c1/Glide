       "min": 0,
       "restart": true,
       "step": 0.5,
       "type": "number"
      },
      {
       "def": true,
       "key": "companion.llm.tune_thinking",
       "label": "Turn Gemini thinking down for callouts",
       "restart": true,
       "type": "bool"
      }
     ],
     "title": "Requests"
    },
    {
     "fields": [
      {
       "def": true,
       "help": "Repeated prompt prefixes (tools, rules, glossary) are read from cache at a tenth of the price or less.",
       "key": "companion.llm.prompt_cache",
       "label": "Prompt caching",
       "restart": true,
       "type": "bool"
      },
      {
       "def": "5m",
       "key": "companion.llm.cache_ttl_fast",
       "label": "Fast model cache lifetime",
       "options": [
        [
         "5m",
         "5 minutes"
        ],
        [
