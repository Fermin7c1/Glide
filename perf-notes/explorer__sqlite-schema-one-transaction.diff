+def test_schema_one_transaction():
+    """Both databases' tables are made in one transaction (regression: one per statement, each a journal file created,
+    flushed and deleted: 20 s of a test on a Windows runner, and on the player's PC at every glide.db build)."""
+    from tools import build_db
+    for make in (store.create_schema, build_db.create_schema):
+        conn = sqlite3.connect(":memory:")
+        seen = []
+        conn.set_trace_callback(seen.append)
+        make(conn)
+        check(len(seen) > 20 and seen[0].strip() == "BEGIN;" and seen[-1].strip() == "COMMIT;" and
+              not conn.in_transaction, "%s: %r ... %r" % (make.__module__, seen[:1], seen[-1:]))
+        conn.close()
+
+
