--- a/tests/kb/test_store.py
+++ b/tests/kb/test_store.py
@@ -45,6 +45,23 @@
+def test_schema_one_transaction(tmpdir):
+    """Both schemas go in as one transaction even on a plain connection: run bare, each CREATE commits (a journal file
+    and its syncs) on its own, 85 of them per kb.db, which made every fixture database cost seconds on Windows."""
+    import build_db
+    for name, create in (("kb", store.create_schema), ("glide", build_db.create_schema)):
+        c = sqlite3.connect(os.path.join(tmpdir, "schema-%s.db" % name))
+        said = []
+        c.set_trace_callback(said.append)
+        create(c)
+        c.set_trace_callback(None)
+        words = [s.split(None, 1)[0].rstrip(";").upper() for s in said if s.strip()]
+        ends = [w for w in words if w in ("BEGIN", "COMMIT")]
+        check(ends == ["BEGIN", "COMMIT"] and not c.in_transaction, "%s schema: %s" % (name, ends))
+        check(c.execute("SELECT count(*) FROM sqlite_master WHERE type = 'table'").fetchone()[0] > 10, name)
+        c.close()
+
+
