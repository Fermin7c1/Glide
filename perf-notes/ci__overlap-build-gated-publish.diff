+          VER: ${{ needs.build.outputs.version }}
+          REPO: Fermin7c1/Glide-releases
+        run: |
+          set -euo pipefail
+          info=$(gh release view "v$VER" --repo "$REPO" --json isDraft,body,assets)
+          src=$(jq -r .body <<<"$info" | sed -n 's/.*source: \([0-9a-f]\{40\}\).*/\1/p' | head -n 1)
+          if [ "$src" != "$GITHUB_SHA" ]; then
+            echo "::error::v$VER was built from ${src:-an unknown commit}, not $GITHUB_SHA: not publishing it"
+            exit 1
+          fi
+          if [ "$(jq -r .isDraft <<<"$info")" != "true" ]; then
+            echo "v$VER is published already"
+            exit 0
+          fi
+          for f in latest.yml "Glide-to-60-Setup-$VER.exe" "Glide-to-60-Setup-$VER.exe.blockmap"; do
+            if ! jq -e --arg f "$f" '[.assets[].name] | index($f) != null' <<<"$info" >/dev/null; then
+              echo "::error::the v$VER draft has no $f: not publishing it"
+              exit 1
+            fi
+          done
+          gh release edit "v$VER" --repo "$REPO" --draft=false --latest
