           GH_TOKEN: ${{ secrets.RELEASES_TOKEN }}
         run: npm run release
 
-      # installed apps only see published releases, so this goes last: a failed upload never reaches them
+  # installed apps only see published releases, so this goes last and waits for both: a failed test, build or upload
+  # never reaches them (needs: a job that failed, or was cancelled or skipped, skips this one)
+  publish:
+    needs: [test, build]
+    if: needs.build.outputs.exists == 'false'
+    runs-on: ubuntu-latest
+    environment: release
+    steps:
+      # only the draft this run built: a re-run of an old run's failed jobs must not publish a draft a newer run has
+      # taken over (its notes name that run's commit) or mark an old version latest again
       - name: Publish the release
-        if: steps.ver.outputs.exists == 'false'
         env:
           GH_TOKEN: ${{ secrets.RELEASES_TOKEN }}
