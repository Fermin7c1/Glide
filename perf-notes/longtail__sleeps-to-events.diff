--- a/tests/test_narrator.py
+++ b/tests/test_narrator.py
 RUN = r"""
+const realImmediate = setImmediate;
+let vnow = Date.now(), vseq = 0, pumping = false;
+const vtimers = new Map();
+const pump = () => { if (!pumping) { pumping = true; realImmediate(fire); } };
+function fire() {
+  pumping = false;
+  let next = null;
+  for (const t of vtimers.values()) if (!next || t.at < next.at || (t.at === next.at && t.id < next.id)) next = t;
+  if (!next) return;
+  vtimers.delete(next.id);
+  vnow = Math.max(vnow, next.at);
+  if (next.every !== undefined) vtimers.set(next.id, { ...next, at: vnow + next.every });
+  next.fn(...next.args);
+  pump();
+}
+const addTimer = (fn, ms, args, every) => {
+  const id = ++vseq, d = Math.max(0, Number(ms) || 0);
+  vtimers.set(id, { id, at: vnow + d, fn, args, every: every ? Math.max(1, d) : undefined });
+  pump();
+  return id;
+};
+globalThis.setTimeout = (fn, ms, ...args) => addTimer(fn, ms, args, false);
+globalThis.setInterval = (fn, ms, ...args) => addTimer(fn, ms, args, true);
+globalThis.clearTimeout = globalThis.clearInterval = (id) => { vtimers.delete(id); };
+Date.now = () => vnow;
