diff --git a/tests/desktop_main_check.cjs b/tests/desktop_main_check.cjs
--- a/tests/desktop_main_check.cjs
+++ b/tests/desktop_main_check.cjs
@@ -46,7 +46,12 @@ const until = async (what, fn, ms = 5000) => {
-const within = (p, ms, what) => Promise.race([p, new Promise((_, rej) => setTimeout(() => rej(new Error(`${what} took over ${ms} ms`)), ms))]);
+// the timer is cleared once p settles: a pending one kept Node (and the test) alive for its full 6 s after "ok"
+const within = (p, ms, what) => {
+  let timer;
+  const late = new Promise((_, rej) => { timer = setTimeout(() => rej(new Error(`${what} took over ${ms} ms`)), ms); });
+  return Promise.race([p, late]).finally(() => clearTimeout(timer));
+};
