{
  "name": "glide-desktop",
  "productName": "Glide to 60",
  "version": "0.4.0",
  "description": "Glide: AI leveling coach for WoW Forever (desktop app)",
  "author": "Fermin7c1",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node scripts/gen-settings.js && tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.dashboard.json && node scripts/copy-static.js",
    "start": "npm run build && electron .",
    "sim": "npm run build && electron . --sim",
    "python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-python.ps1",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "release": "npm run build && electron-builder --win nsis --publish always",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "44.10.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.fermin7c1.glide",
    "productName": "Glide to 60",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "changelog.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "extraResources": [
      {
        "from": "../companion",
        "to": "engine/companion",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../knowledge",
        "to": "engine/knowledge",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!eval{,/**}"
        ]
      },
      {
        "from": "../tools",
        "to": "engine/tools",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!build_seed.py",
          "!lua_sandbox.py",
          "!refresh_community.py",
          "!step_videos.py",
          "!kb_report.py",
          "!archive.ps1"
        ]
      },
      {
        "from": "../wowfiles",
        "to": "engine/wowfiles",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../addon/Glide",
        "to": "engine/addon/Glide"
      },
      {
        "from": "../data/seed",
        "to": "engine/data/seed"
      },
      {
        "from": "build/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Fermin7c1",
        "repo": "Glide-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Glide",
      "uninstallDisplayName": "Glide"
    },
    "electronLanguages": [
      "en-US"
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "koffi": "3.3.3"
  },
  "allowScripts": {
    "koffi@3.3.3": true,
    "electron-winstaller": false
  }
}
